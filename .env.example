# Fill locally. Never commit real values. Never paste them into chat.

# Solami dashboard → API Keys
SOLAMI_RPC_TOKEN=
SOLAMI_GRPC_TOKEN=

# Optional overrides if the dashboard shows a specific host
# SOLAMI_RPC_URL=https://rpc.solami.dev
# SOLAMI_GRPC_URL=https://grpc.solami.dev

# Ingest WebSocket the board connects to
DRAIN_WS_PORT=8787
NEXT_PUBLIC_DRAIN_WS=ws://127.0.0.1:8787

# Ignore removes smaller than this (SOL)
DRAIN_MIN_SOL=1

# How long to watch the puller for an outbound transfer (ms)
DRAIN_SENT_ON_MS=25000

# Leave empty. Do not turn mock data on for the bounty demo.
DRAIN_PREVIEW=
